# Copy to .env.local and fill in.

# Admin account created on first boot if no user with this email exists.
# If the user already exists, it is promoted to admin (its password is not changed).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_DISPLAY_NAME=Admin

# SQLite database file (created automatically).
DATABASE_PATH=./data/app.db

# JSON file cache of the full Simpsons character list, and how often to refresh it.
CHARACTER_CACHE_PATH=./data/characters-cache.json
CHARACTER_CACHE_TTL_HOURS=24
